{
  "manifest_version": 3,
  "name": "Omanero tips",
  "version": "0.4.1",
  "description": "Shows a Tip control next to Monero addresses on X and GitHub and hands them to the omanero wallet on your desktop. Holds no keys. Its only requests read a repo's manifest.json and FUNDING.yml while that repo is on screen.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "background": { "service_worker": "background-2.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["detect.js", "pill.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["detect.js", "pill.js", "github.js"],
      "run_at": "document_idle"
    }
  ]
}
