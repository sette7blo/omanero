{
  "manifest_version": 3,
  "name": "Omanero for X",
  "version": "0.1.0",
  "description": "Shows a Tip control next to Monero addresses on X and hands them to the omanero wallet on your desktop. Holds no keys and makes no network requests.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["detect.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
